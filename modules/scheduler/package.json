{
  "name": "pi-scheduler",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Scheduler source snapshot metadata; dependencies and installation are managed by the pi-better-tools root package.",
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test:unit": "node ../../node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "node ../../node_modules/vitest/vitest.mjs run tests/integration"
  }
}
