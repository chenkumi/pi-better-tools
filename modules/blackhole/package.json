{
  "name": "pi-blackhole",
  "version": "0.5.12",
  "private": true,
  "description": "Unified compaction + observational memory extension for Pi — compresses conversation context while preserving durable observations and reflections",
  "keywords": [
    "agents",
    "ai",
    "blackhole",
    "cli",
    "compact",
    "compaction",
    "observational-memory",
    "pi",
    "pi-agent",
    "pi-blackhole",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "recall"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k0valik/pi-blackhole.git"
  },
  "files": [
    "*.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!tests/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "example-config.json"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "typebox": "1.3.34",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1 <2.0.0",
    "@earendil-works/pi-ai": ">=0.85.1 <2.0.0",
    "@earendil-works/pi-coding-agent": ">=0.85.1 <2.0.0",
    "@earendil-works/pi-tui": ">=0.85.1 <2.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
