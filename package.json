{
    "name": "pi-better-tools",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "description": "A single Pi package integrating subagents, shell, precise file, web, note, GPT speed, JSON Schema delivery and cross-platform PTY extensions.",
    "type": "module",
    "keywords": [
        "pi-package",
        "pi-extension",
        "tools"
    ],
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "bin": {
        "pi-better-tools": "setup/cli.mjs"
    },
    "files": [
        "setup",
        "shared/src",
        "shared/README.md",
        "modules/*/README.md",
        "modules/*/LICENSE",
        "modules/subagents/extensions",
        "modules/subagents/src",
        "modules/subagents/agents",
        "modules/subagents/prompts",
        "modules/shell-tools/extensions",
        "modules/shell-tools/src",
        "modules/file-tools/extensions",
        "modules/file-tools/src",
        "modules/web-tools/src",
        "modules/web-tools/schemas",
        "modules/web-tools/examples",
        "modules/note-tools/extensions",
        "modules/note-tools/src",
        "modules/file-audit/src",
        "modules/pi-runtime/src",
        "modules/skill-tools/src",
        "modules/skill-tools/skills",
        "modules/theme-tools/src",
        "modules/theme-tools/themes",
        "modules/monitor/src",
        "modules/monitor/package.json",
        "modules/fork/src",
        "modules/fork/package.json",
        "modules/remote/src",
        "modules/remote/package.json",
        "modules/gpt-speed/extensions",
        "modules/gpt-speed/src",
        "modules/pi-custom-panel/src",
        "modules/json-schema/extensions",
        "modules/json-schema/src",
        "modules/sqlite-tools/src",
        "modules/sql-connector/src",
        "modules/sql-connector/examples",
        "modules/pty-terminal/src",
        "modules/pty-terminal/README.md",
        "modules/pty-terminal/LICENSE",
        "modules/schedule-commands/src",
        "modules/schedule-commands/package.json",
        "modules/pi-auto-compact/src",
        "modules/pi-auto-compact/package.json",
        "modules/schedule-commands/README.md",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "docs/architecture.md",
        "docs/configuration.md",
        "docs/migration.md"
    ],
    "pi": {
        "extensions": [
            "./modules/shell-tools/src/index.ts",
            "./modules/file-tools/src/index.ts",
            "./modules/subagents/src/index.ts",
            "./modules/web-tools/src/index.ts",
            "./modules/note-tools/src/index.ts",
            "./modules/file-audit/src/index.ts",
            "./modules/sqlite-tools/src/index.ts",
            "./modules/sql-connector/src/index.ts",
            "./modules/pi-runtime/src/index.ts",
            "./modules/skill-tools/src/index.ts",
            "./modules/theme-tools/src/index.ts",
            "./modules/monitor/src/index.ts",
            "./modules/fork/src/index.ts",
            "./modules/remote/src/index.ts",
            "./modules/gpt-speed/src/index.ts",
            "./modules/json-schema/src/index.ts",
            "./modules/pty-terminal/src/index.ts",
            "./modules/schedule-commands/src/index.ts",
            "./modules/pi-auto-compact/src/index.ts",
            "./modules/pi-custom-panel/src/index.ts",
            "./modules/file-tools/src/fff-override.mjs"
        ],
        "themes": [
            "./modules/theme-tools/themes"
        ],
        "prompts": [
            "./modules/subagents/prompts"
        ]
    },
    "scripts": {
        "build": "node scripts/run-checks.mjs build",
        "typecheck": "node scripts/run-checks.mjs typecheck",
        "lint": "eslint . --max-warnings 0",
        "test": "node scripts/run-checks.mjs unit",
        "test:integration": "node scripts/run-checks.mjs integration",
        "test:module": "node scripts/run-checks.mjs module",
        "test:cross": "node scripts/run-checks.mjs cross",
        "test:browser": "node scripts/run-checks.mjs browser",
        "test:heavy": "node scripts/run-checks.mjs heavy",
        "test:package": "node scripts/package-smoke.mjs",
        "check": "npm run build && npm run typecheck && npm run lint && npm test && npm run test:integration && npm run test:package",
        "pty:install": "node setup/cli.mjs pty setup",
        "prepack": "npm run build"
    },
    "allowScripts": {
        "node-pty@1.2.0-beta.18": true,
        "msnodesqlv8@6.2.1": true
    },
    "dependencies": {
        "@ff-labs/pi-fff": "0.11.0",
        "@mozilla/readability": "0.6.0",
        "@xterm/headless": "6.0.0",
        "croner": "11.0.0",
        "diff": "9.0.0",
        "ipaddr.js": "2.5.0",
        "jsdom": "30.1.3",
        "mssql": "12.7.13",
        "mysql2": "3.24.6",
        "node-pty": "1.2.0-beta.18",
        "pg": "8.23.1",
        "proper-lockfile": "4.1.2",
        "turndown": "7.2.4",
        "turndown-plugin-gfm": "1.0.2",
        "ulid": "3.0.2",
        "ws": "8.22.0",
        "zod": "4.6.7"
    },
    "optionalDependencies": {
        "msnodesqlv8": "6.2.1"
    },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": "*",
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "1.5.0",
        "@earendil-works/pi-ai": "1.5.0",
        "@earendil-works/pi-coding-agent": "1.5.0",
        "@earendil-works/pi-tui": "1.5.0",
        "@types/jsdom": "^30.0.0",
        "@types/mssql": "12.3.0",
        "@types/node": "22.20.5",
        "@types/pg": "8.23.1",
        "@types/proper-lockfile": "^4.1.4",
        "@types/turndown": "^5.0.5",
        "@types/ws": "8.18.2",
        "@typescript-eslint/eslint-plugin": "8.72.1",
        "@typescript-eslint/parser": "8.72.1",
        "eslint": "10.13.0",
        "tsx": "^4.23.15",
        "typebox": "1.3.37",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
